  "type": "module",
  "dependencies": {
    "@hono/zod-validator": "^0.5.0",
    "hono": "^4.10.4",
    "lucide-react": "^0.510.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router": "^7.5.3",
    "recharts": "^3.3.0",
    "tesseract.js": "^6.0.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.0",
    "@eslint/js": "9.25.1",
    "@types/node": "22.14.1",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.19",
    "globals": "15.15.0",
    "jspdf": "^3.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "5.8.3",
    "typescript-eslint": "8.31.0",
    "vite": "^6.0.0",
    "wrangler": "^4.33.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc && vite build",
    "cf-typegen": "wrangler types",
    "deploy:prod": "node scripts/ensure-wrangler-config.js && npm run build && npx wrangler deploy --config ./wrangler.json",
    "deploy:dry-root": "node scripts/ensure-wrangler-config.js && npx wrangler deploy --dry-run --config ./wrangler.json",
    "deploy:static": "npm run build && node scripts/prepare-static-deploy.js",
    "deploy:wrangler": "wrangler publish --env production",
    "dev": "vite",
    "lint": "eslint ."
  }
