MOCHA_USERS_SERVICE_API_URL=https://users-service.getmocha.com/api
MOCHA_USERS_SERVICE_API_KEY=your-mocha-api-key
JWT_SECRET=your-jwt-secret
RESEND_API_KEY=your-resend-api-key
# Set to 'true' to allow DBA endpoint to perform write operations (INSERT/UPDATE/DELETE/DDL).
# Keep this false/undefined in production unless strictly needed.
ALLOW_DBA_WRITE=false
# Add other environment variables needed for development here
